<script setup>
import { ref, onMounted } from 'vue';
import { getArticles } from '@/api'; // Adjust path as needed

const articles = ref([]);
const page = ref(1);
const loading = ref(false);
const finished = ref(false);

const loadArticles = async () => {
  if (loading.value || finished.value) return;
  
  loading.value = true;
  try {
    const res = await getArticles({
      page: page.value,
      limit: 10
    });
    
    if (res.list.length === 0) {
      finished.value = true;
    } else {
      articles.value.push(...res.list);
      page.value++;
    }
  } catch (error) {
    console.error('Failed to load articles:', error);
  } finally {
    loading.value = false;
  }
};

onMounted(() => {
  loadArticles();
});
</script>

<template>
  <!-- Your existing template -->
  <div v-for="article in articles" :key="article.id" class="article-card">
    <img :src="article.coverImage" v-if="article.coverImage" />
    <h3>{{ article.title }}</h3>
    <p>{{ article.summary }}</p>
    <!-- ... -->
  </div>
</template>
