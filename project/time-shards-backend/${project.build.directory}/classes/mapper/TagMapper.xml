<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.timeshards.mapper.TagMapper">

    <resultMap id="BaseResultMap" type="com.timeshards.entity.Tag">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="slug" property="slug" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="Base_Column_List">id, name, slug, create_time</sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM blog_tag WHERE id = #{id}
    </select>

    <select id="selectByName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM blog_tag WHERE name = #{name}
    </select>

    <select id="selectBySlug" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM blog_tag WHERE slug = #{slug}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM blog_tag ORDER BY create_time DESC
    </select>

    <!-- 高级功能：查询热门标签 -->
    <select id="selectHotTags" resultMap="BaseResultMap">
        SELECT t.id, t.name, t.slug, t.create_time, COUNT(bat.article_id) as count
        FROM blog_tag t
        LEFT JOIN blog_article_tag bat ON t.id = bat.tag_id
        GROUP BY t.id
        ORDER BY count DESC
        LIMIT #{limit}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO blog_tag (name, slug, create_time) VALUES (#{name}, #{slug}, NOW())
    </insert>

    <update id="updateById">
        UPDATE blog_tag
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="slug != null and slug != ''">slug = #{slug},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM blog_tag WHERE id = #{id}
    </delete>

</mapper>